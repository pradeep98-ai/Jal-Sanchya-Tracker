<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/screenTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/screenSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your water wealth at a glance"
            android:textColor="#D7F2EF"
            android:textSize="14sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/navDashboardButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Dashboard" />

            <Button
                android:id="@+id/navSetupButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Setup" />

            <Button
                android:id="@+id/navRainfallButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Rainfall" />

            <Button
                android:id="@+id/navProfileButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Profile" />

            <Button
                android:id="@+id/navReportButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Report" />

            <Button
                android:id="@+id/navHistoryButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="History" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/screenHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/dashboardScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.mindmatrix.jalsanchaytracker.ui.WaterTankView
                    android:id="@+id/waterTankView"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />

                <TextView
                    android:id="@+id/todayLitresText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/primary"
                    android:gravity="center"
                    android:padding="14dp"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/totalLitresText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/success"
                    android:gravity="center"
                    android:padding="14dp"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/waterDaysText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/accent"
                    android:gravity="center"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/dashboardAddRainButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Go to rainfall entry" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/setupScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/setupStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Roof area"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/roofAreaInput"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Example: 850"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tank capacity in litres"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/tankCapacityInput"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Example: 2000"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Roof surface type"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/surfaceSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="56dp" />

                <Button
                    android:id="@+id/saveSetupButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:text="Save setup and view profile" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/rainfallScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/rainfallHelpText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Rainfall in millimetres"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/rainfallInput"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Example: 24"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted" />

                <Button
                    android:id="@+id/addRainfallButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Calculate and save rainfall" />

                <TextView
                    android:id="@+id/latestEntryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/profileScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/profileSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:textColor="@color/ink"
                android:textSize="17sp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/reportScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/monthlyReportText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tipsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/shareReportButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:text="Share report" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/historyScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/emptyHistoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No rainfall entries yet."
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
